{
  "name": "superai-rakkyxd",
  "version": "1.0.46",
  "description": "All your AI assistants in a single, minimal, privacy-first desktop workspace with 3D pixel lab & Thai voice dictation.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakgoorak/SuperAi-RAKKYXD.git"
  },
  "bugs": {
    "url": "https://github.com/rakgoorak/SuperAi-RAKKYXD/issues"
  },
  "homepage": "https://github.com/rakgoorak/SuperAi-RAKKYXD#readme",
  "workspaces": [
    "packages/*",
    "packages/studio/client"
  ],
  "scripts": {
    "build": "npm --workspace=@superai-rakkyxd/core run build && npm --workspace=@superai-rakkyxd/studio run build && npm --workspace=@superai-rakkyxd/client run build && npm --workspace=@superai-rakkyxd/desktop run build && node scripts/brand-dev-electron.mjs",
    "test": "npm run test --workspaces",
    "studio": "node packages/studio/dist/index.js",
    "prestart": "node scripts/brand-dev-electron.mjs",
    "start": "electron packages/desktop",
    "preapp": "node scripts/brand-dev-electron.mjs",
    "app": "electron packages/desktop",
    "dev": "npm --workspace=@superai-rakkyxd/client run dev",
    "dev:server": "tsx packages/studio/server/index.ts",
    "test:desktop": "node packages/desktop/test/smoke.mjs",
    "test:permission-popup": "node packages/desktop/test/permission-popup-smoke.mjs",
    "test:layout": "node packages/desktop/test/layout-smoke.mjs",
    "test:overflow": "node packages/desktop/test/overflow-audit-smoke.mjs",
    "test:usage-overlay": "node packages/desktop/test/usage-overlay-smoke.mjs",
    "test:terminal-render": "node packages/desktop/test/terminal-render-smoke.mjs",
    "test:tray": "node packages/desktop/test/tray-smoke.mjs",
    "test:browser-tools": "node packages/desktop/test/browser-tools-smoke.mjs",
    "i18n:check": "node scripts/i18n-merge.mjs --check",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "package:release": "node scripts/package-release.mjs",
    "archive:release": "node scripts/archive-release.mjs",
    "test:release": "node packages/desktop/test/release-smoke.mjs",
    "test:team": "node packages/desktop/test/team-smoke.mjs",
    "test:voice": "node packages/desktop/test/voice-smoke.mjs",
    "installer:release": "node scripts/build-installer.mjs",
    "manifests:update": "node scripts/generate-package-manifests.mjs",
    "test:session-controls": "node packages/desktop/test/session-controls-smoke.mjs",
    "test:conversation-ui": "node packages/desktop/test/conversation-workspace-smoke.mjs",
    "test:conversation-interactions": "node packages/desktop/test/conversation-interactions-smoke.mjs",
    "test:project-usability": "node packages/desktop/test/project-usability-smoke.mjs",
    "test:provider-conversation": "node packages/desktop/test/provider-conversation-smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.7.0",
    "rcedit": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.4"
  }
}
