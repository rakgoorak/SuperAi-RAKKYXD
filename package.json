{
  "name": "superai-rakkyxd",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/studio/client"
  ],
  "scripts": {
    "build": "npm --workspace=@opencode-multi/core run build && npm --workspace=@bridgemind/studio run build && npm --workspace=@bridgemind/client run build && npm --workspace=@bridgemind/desktop run build && npm --workspace=@superai/voice run build",
    "test": "npm run test --workspaces",
    "studio": "node packages/studio/dist/index.js",
    "app": "electron packages/desktop",
    "start": "electron packages/desktop",
    "dev": "npm --workspace=@bridgemind/client run dev",
    "voice": "electron packages/voice",
    "dev:server": "tsx packages/studio/server/index.ts",
    "test:desktop": "node packages/desktop/test/smoke.mjs",
    "test:layout": "node packages/desktop/test/layout-smoke.mjs",
    "test:reference": "node packages/desktop/test/reference-smoke.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "package:release": "node scripts/package-release.mjs",
    "archive:release": "node scripts/archive-release.mjs",
    "test:release": "node packages/desktop/test/release-smoke.mjs",
    "test:team": "node packages/desktop/test/team-smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.4"
  }
}
