# ========================================================
# SuperAi & RAKKYXD - Environment Configuration Example
# Copy this file to .env to customize local development
# ========================================================

# Server Configuration
SUPERAI_PORT=3000
# SUPERAI_DATA_DIR=C:/Users/your-username/.superai-custom-data

# Local Ollama Provider URL (Default: http://127.0.0.1:11434)
SUPERAI_OLLAMA_URL=http://127.0.0.1:11434

# Cloud AI Provider API Keys (Optional - Can also be set directly in the UI)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Windows Release Code Signing (Only needed when packaging official releases)
# WIN_CERT_FILE=path/to/certificate.pfx
# WIN_CERT_PASSWORD=your_certificate_password
