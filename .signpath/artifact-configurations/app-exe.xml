<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app-exe": the app's own executable, signed before the
     portable ZIP and the installer are built from it. Paste into the SignPath project. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="SuperAi-RAKKYXD.exe" product-name="SuperAi &amp; RAKKYXD" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
